# -----------------------------
# Node.js backend .gitignore
# -----------------------------

# Node modules
node_modules/

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
jspm_packages/

# OS-specific
.DS_Store
Thumbs.db

# Optional npm cache
.npm/

# Coverage directories
coverage/

# IDEs / editors
.vscode/
.idea/
*.swp

# Build
dist/
build/

# Debug
*.tgz

# dotenvx prebuild
.env.prebuild

# Misc
*.bak
*.orig
